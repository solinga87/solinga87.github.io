<div class="course-listing">
<% for (const item of items) { %>
<div class="course-item">
<div class="course-thumb">
<a href="<%= item.path %>"><img src="<%= item.image ? item.image : 'images/course-placeholder.svg' %>" alt="<%= item['image-alt'] ? item['image-alt'] : item.title %>" loading="lazy"></a>
<% if (item['image-caption']) { %>
<figcaption class="course-thumb-caption"><%= item['image-caption'] %></figcaption>
<% } %>
</div>
<div class="course-body">
<% if (item['listing-label']) { %>
<div class="course-label"><%= item['listing-label'] %></div>
<% } %>
<h3 class="course-title"><a href="<%= item.path %>"><%= item.title %></a></h3>
<div class="course-authors"><%= item.author ? item.author : 'Serge Olinga Olinga' %></div>
<% if (item['pub-info']) { %>
<div class="course-pubinfo"><%= item['pub-info'] %></div>
<% } %>
<% if (item.description) { %>
<p class="course-desc"><%= item.description %></p>
<% } %>
<div class="course-links">
<% const reportHref = (item['link-report'] && item['link-report'] !== '#') ? item['link-report'] : item.path; %>
<a class="btn btn-sm btn-primary" href="<%= reportHref %>">Rapport / Document</a>
<% if (item['link-code'] && item['link-code'] !== '#') { %>
<a class="btn btn-sm btn-outline-secondary" href="<%= item['link-code'] %>">Code</a>
<% } %>
</div>
</div>
</div>
<% } %>
</div>
